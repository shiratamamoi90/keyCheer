{
  "name": "keycheer",
  "productName": "TypeYell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "キー押下数・打鍵速度に応じてキャラが応援してくれる Windows デスクトップアプリ",
  "main": "dist/main/index.js",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/postbuild.mjs && npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.js -i src/renderer/styles/main.css -o dist/renderer/main.css --minify && tailwindcss -c tailwind.config.js --content \"./src/renderer/popup*.{ts,html}\" -i src/renderer/styles/popup.css -o dist/renderer/popup.css --minify",
    "dev": "npm run build && electron dist/main/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "eval": "tsx src/eval/index.ts",
    "services:up": "docker compose --profile cpu up -d",
    "services:down": "docker compose --profile cpu --profile gpu down",
    "services:model": "bash scripts/import-sarashina.sh",
    "services:status": "docker compose --profile cpu --profile gpu ps",
    "fetch:sdcpp": "bash scripts/fetch-sdcpp.sh",
    "fetch:u2netp": "bash scripts/fetch-u2netp.sh",
    "weights:text": "bash scripts/extract-text-model.sh",
    "package:win": "npm run fetch:runtimes && npm run build && electron-builder --win --dir",
    "deploy:win": "npm run package:win && bash scripts/deploy-windows.sh",
    "fetch:ollama": "bash scripts/fetch-ollama.sh",
    "fetch:voicevox": "bash scripts/fetch-voicevox.sh",
    "fetch:runtimes": "npm run fetch:sdcpp && npm run fetch:u2netp && npm run fetch:ollama && npm run fetch:voicevox",
    "package:installer": "npm run fetch:runtimes && npm run build && node scripts/build-installer-license.mjs && bash scripts/build-installer.sh",
    "weights:image": "bash scripts/fetch-image-weights.sh"
  },
  "build": {
    "directories": {
      "output": "release",
      "buildResources": "installer"
    },
    "files": [
      "dist/**/*",
      "assets/licenses/**/*",
      "assets/icon.png",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/{linux,darwin}/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/x64/DirectML.dll",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/x64/dxcompiler.dll",
      "!node_modules/onnxruntime-node/script/**",
      "!node_modules/adm-zip/**",
      "!node_modules/global-agent/**",
      "!node_modules/matcher/**",
      "!node_modules/serialize-error/**",
      "!node_modules/globalthis/**",
      "!node_modules/define-properties/**",
      "!node_modules/object-keys/**",
      "!node_modules/define-data-property/**",
      "!node_modules/es-define-property/**",
      "!node_modules/es-errors/**",
      "!node_modules/gopd/**",
      "!node_modules/has-property-descriptors/**",
      "!node_modules/escape-string-regexp/**"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/sdcpp",
        "to": "sdcpp",
        "filter": [
          "**/*",
          "!.tag",
          "!sd-server.exe",
          "!start-server.*"
        ]
      },
      {
        "from": "vendor/u2netp",
        "to": "u2netp",
        "filter": [
          "u2netp.onnx"
        ]
      },
      {
        "from": "vendor/ollama",
        "to": "ollama",
        "filter": [
          "**/*",
          "!.tag"
        ]
      },
      {
        "from": "vendor/voicevox",
        "to": "voicevox",
        "filter": [
          "**/*",
          "!.tag"
        ]
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "installer/license.txt",
      "include": "installer/installer.nsh",
      "deleteAppDataOnUninstall": true,
      "installerLanguages": [
        "ja_JP"
      ],
      "language": "1041",
      "artifactName": "TypeYell-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-store": "10.0.1",
    "onnxruntime-node": "1.31.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uiohook-napi": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
