{
  "name": "keycheer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "キー押下数・打鍵速度に応じてキャラが応援してくれる Windows デスクトップアプリ",
  "main": "dist/main/index.js",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "npm run build && electron dist/main/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "eval": "tsx src/eval/index.ts"
  },
  "dependencies": {
    "electron-store": "10.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uiohook-napi": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
