{
  // 配布用の出力設定。src だけを dist へ出す(tests は含めない)。
  // rootDir=src なので dist/main/index.js・dist/preload/index.js・dist/renderer/popup.js が並ぶ
  // (package.json の main が指す位置)。バンドラは使わない(change 0007 確定事項 #1)。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // 計測(src/eval)は配布物に入れない(論点 0056)。npm run eval は tsx で src/eval を直に動かす
  "exclude": ["node_modules", "dist", "tests", "src/eval"]
}
